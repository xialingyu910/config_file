        "detour": "默认代理"
      },
      {
        "tag": "fake-ip-dns-server",
        "type": "fakeip",
        "inet4_range": "198.19.0.0/16"
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "doh.pub": [
            "1.12.12.21",
            "120.53.53.53"
          ]
        }
      }
    ],
    "rules": [
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "server": "ali"
      },
      {
        "clash_mode": "Global",
        "server": "fake-ip-dns-server"
      },
      {
        "domain_suffix": [
          "push.apple.com",
          "tencentgames.com"
        ],
        "server": "ali"
      },
      {
        "rule_set": [
          "games_cn",
          "AppStore",
          "applemusic_domain",
          "appletv_domain"
        ],
        "server": "ali"
      },
      {
        "rule_set": [
          "fakeipfilter-cn",
          "oc-cn-domain",
          "geosite-microsoft@cn",
          "geosite-apple@cn",
          "private_domain"
        ],
        "server": "ali"
      },
      {
        "rule_set": "fakeipfilter-!cn",
        "server": "google"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": [
              "A",
              "AAAA"
            ]
          },
          {
            "rule_set": "geolocation-!cn",
            "invert": true
          }
        ],
        "action": "evaluate",
        "server": "google",
        "client_subnet": "223.5.5.0/24",
        "timeout": "2s"
      },
      {
        "match_response": true,
        "rule_set": "cn_ip",
        "server": "ali"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fake-ip-dns-server",
        "rewrite_ttl": 1
      }
    ],
    "final": "google",
    "strategy": "ipv4_only",
    "cache_capacity": 8192,
    "optimistic": {
      "enabled": true
    },
    "reverse_mapping": true
  },
