  "providers": [
    {
      "tag": "tag",
      "type": "remote",
      "url": "https://example.com/subscription/tag",
      "health_check": {
        "enabled": true,
        "url": "https://www.gstatic.com/generate_204",
        "interval": "10m",
        "timeout": "3s"
      },
      "exclude": "官网|剩余|流量|套餐|免费|订阅|全球直连|到期时间|Expire Date|Traffic|ExpireDate",
      "http_client": "订阅下载",
      "initial_path": "/etc/momo/providers/tag.yaml"
    },
    {
      "tag": "wd",
      "type": "remote",
      "url": "https://example.com/subscription/wd",
